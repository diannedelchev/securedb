# SecureDB Web Client — environment configuration

# HTTP listen address
APP_ADDR=:8080

# Application database (PostgreSQL)
DATABASE_URL=postgres://securedb:securedb@localhost:5433/securedb?sslmode=disable

# REQUIRED: 32-byte hex key for AES-256-GCM encryption of stored DB credentials.
# Generate with: openssl rand -hex 32
APP_ENCRYPTION_KEY=

# Sessions
SESSION_TTL=8h
SESSION_IDLE_TTL=45m
# Set true when serving over HTTPS
COOKIE_SECURE=false

# Seed demo users/connections on first boot
SEED_DEMO_DATA=true

# Query guardrail fallbacks (per-environment values live in security_policies)
DEFAULT_MAX_ROWS=500
DEFAULT_QUERY_TIMEOUT=30s

# Set true only behind a trusted reverse proxy (uses X-Forwarded-For)
TRUST_PROXY_IP=false
